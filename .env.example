# 필수값만 둔다. 포트·JWK 대기·DB 사용자·보존 정리·분산 제한·Redis 같은 선택 설정은
# compose.yml 기본값을 따르며 바꿀 때만 추가한다.
BATON_GO_MANAGEMENT_JWT_ISSUER_URI=http://localhost:9000/issuer
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost:9000/issuer/jwks
BATONGO_LINKCODE_KEYS_DEFAULT=REPLACE_ME_TOO
BATON_GO_PUBLIC_BASE_URL=http://localhost:8080
BATON_GO_PUBLIC_RESOLVER_RATE_LIMIT_CAPACITY=300
BATON_GO_PUBLIC_RESOLVER_RATE_LIMIT_WINDOW=1m
BATON_GO_BATON_BASE_URL=http://localhost:5173
BATON_GO_ROUND_BASE_URL=http://localhost:5174
BATON_GO_DB_PASSWORD=replace-me
BATON_GO_DB_ROOT_PASSWORD=replace-root-password
