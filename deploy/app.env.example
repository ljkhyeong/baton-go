# 애플리케이션 주입값 예시다. 빈 필수값은 실제 값으로 채운다.
# 이 파일만으로 DB·인증 서버·인증서·k3s를 구성하지 않는다.
BATON_GO_PUBLIC_BASE_URL=https://go.b4ton.com
BATON_GO_BATON_BASE_URL=https://b4ton.com
BATON_GO_ROUND_BASE_URL=https://b4ton.com

# JWT 발급자가 제공한 issuer·JWK 주소를 사용한다. 두 값은 HTTPS여야 한다.
BATON_GO_MANAGEMENT_JWT_ISSUER_URI=
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=
BATON_GO_MANAGEMENT_JWT_AUDIENCE=baton-go
BATON_GO_MANAGEMENT_JWK_CONNECT_TIMEOUT=3s
BATON_GO_MANAGEMENT_JWK_READ_TIMEOUT=5s

# 새 DB용 HMAC 비밀값은 별도로 발급한다. 기존 DB에서는 발급 당시 값을 유지한다.
BATON_GO_LINK_CODE_SECRET=
BATON_GO_DB_URL=
BATON_GO_DB_USERNAME=baton_go
BATON_GO_DB_PASSWORD=

# 기존 k3s 구성처럼 마이그레이션 완료 후 애플리케이션을 시작한다.
SPRING_FLYWAY_ENABLED=false
BATON_GO_DISTRIBUTED_RESOLVER_QUOTA_ENABLED=false
BATON_GO_LINK_RETENTION_ENABLED=false
BATON_GO_TARGET_CONTRACT_OPERATIONS_ENABLED=false
